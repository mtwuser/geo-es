{
  "scope": "federation",
  "layer_id": "geo-es",
  "visibility": "public",
  "target_environments": [
    "pro"
  ],
  "intranet_topology": {
    "base_domain": "geo-es.knowledge.local",
    "node_host": "geo-es.knowledge.local",
    "port": 8720,
    "promotion_pipeline": "staged",
    "visibility": "public",
    "environment_promotion_order": [
      "dev",
      "tst",
      "pre",
      "pro"
    ],
    "environment_subdomains": {
      "dev": "https://dev.geo-es.knowledge.local",
      "tst": "https://tst.geo-es.knowledge.local",
      "pre": "https://pre.geo-es.knowledge.local",
      "pro": "https://geo-es.knowledge.local"
    },
    "local_environment_urls": {
      "dev": "http://127.0.0.1:8720/?env=dev",
      "tst": "http://127.0.0.1:8720/?env=tst",
      "pre": "http://127.0.0.1:8720/?env=pre",
      "pro": "http://127.0.0.1:8720/?env=pro"
    },
    "environment_reachability": {
      "dev": "local-loopback-only",
      "tst": "local-preview-unprovisioned-intranet",
      "pre": "local-preview-unprovisioned-intranet",
      "pro": "public-remote-live"
    },
    "remote_production_url": "https://github.com/mtwuser/geo-es.git",
    "active_subdomain_url": "https://dev.geo-es.knowledge.local",
    "localhost_url": "http://127.0.0.1:8720/?env=dev"
  },
  "mounted_layers": [],
  "fleet_plugin_inventory": [
    {
      "workspace_id": "geo-es",
      "workspace_path": ".",
      "plugin_id": "node-work-cockpit",
      "status": "healthy",
      "environment": "dev",
      "daemon_active": false,
      "localhost_url": "http://127.0.0.1:8720/?env=dev"
    }
  ],
  "cloud_iac_target": {
    "provider": "google-cloud-iac",
    "environment": "dev",
    "stage": "local-cockpit",
    "iac_manifest": "surfaces/infra/cloud_deployment.json"
  }
}
